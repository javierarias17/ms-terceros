# Environment / secrets
# application.yml SÍ se versiona (solo tiene placeholders ${VAR:...}, sin secretos reales) —
# es el que realmente empaqueta el jar; si se ignora, el deploy queda sin ninguna configuración.
# Los valores reales para correr local van en application-local.yml (gitignorado) + perfil "local".
.env
.env.local
application-local.yml
application-local.yaml

# Test output
/test-output/

# IaC — parámetros reales (pueden traer rutas/nombres sensibles); usa infra/main.parameters.example.json
infra/main.parameters.json
infra/*.local.json
